generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Utilisateur {
  id         Int      @id @default(autoincrement())
  nom        String
  email      String   @unique
  motDePasse String
  role       String   // "ADMIN" ou "VENDEUR"
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
}
model Categorie {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  produits Produit[]
}

model Fournisseur {
  id        Int       @id @default(autoincrement())
  nom       String
  telephone String?
  adresse   String?
  produits  Produit[]
}

model Produit {
  id            Int          @id @default(autoincrement())
  nom           String
  prix          Float
  stock         Int          @default(0)
  seuilAlerte   Int          @default(5)
  codeQR        String       @unique
  createdAt     DateTime     @default(now())
  categorieId   Int?
  categorie     Categorie?   @relation(fields: [categorieId], references: [id])
  fournisseurId Int?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  lignesVente   LigneVente[]
}

model Client {
  id          Int      @id @default(autoincrement())
  nom         String
  telephone   String?
  soldeCredit Float    @default(0)
  createdAt   DateTime @default(now())
  ventes      Vente[]
}

model Vente {
  id          Int          @id @default(autoincrement())
  client      Client       @relation(fields: [clientId], references: [id])
  clientId    Int
  date        DateTime     @default(now())
  estCredit   Boolean      @default(false)
  montantPaye Float        @default(0)
  lignesVente LigneVente[]
  facture     Facture?
}

model LigneVente {
  id        Int      @id @default(autoincrement())
  vente     Vente    @relation(fields: [venteId], references: [id])
  venteId   Int
  produit   Produit  @relation(fields: [produitId], references: [id])
  produitId Int
  quantite  Int
  prixUnite Float
  retours   Retour[]
}

model Facture {
  id           Int      @id @default(autoincrement())
  numero       String   @unique
  vente        Vente    @relation(fields: [venteId], references: [id])
  venteId      Int      @unique
  dateEmission DateTime @default(now())
  statut       String   // "PAYEE", "CREDIT" ou "PARTIELLE"
}

model ParametresCommerce {
  id                Int    @id @default(autoincrement())
  nomCommerce       String
  typeCommerce      String?
  devise            String @default("TND")
  seuilAlerteDefaut Int    @default(5)
}


model Retour {
  id           Int        @id @default(autoincrement())
  ligneVente   LigneVente @relation(fields: [ligneVenteId], references: [id])
  ligneVenteId Int
  quantite     Int
  montant      Float
  date         DateTime   @default(now())
}